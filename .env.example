# AI provider: local | fireworks
AI_PROVIDER=local

# Local Ollama/OpenAI-compatible endpoint
LOCAL_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_API_KEY=ollama
LOCAL_MODEL=qwen3.5:9b-q4_K_M

# Fireworks OpenAI-compatible endpoint
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/glm-5p2

# Autodesk Fusion local MCP endpoint
FUSION_MCP_URL=http://127.0.0.1:27182/mcp
FUSION_MCP_ENABLED=true

# Agent limits
MAX_AGENT_STEPS=12
TEMPERATURE=0.2
PORT=3000
HOST=127.0.0.1

# Local project database
DATABASE_PATH=./data/factory.db
